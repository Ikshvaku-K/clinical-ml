# Isolated tooling (project-local Python, uv cache, envs)
.tools/
# Markdown other than the root README stays local and private
*.md
!/README.md
.venv/
.venv-*/
.venv-airflow/
.venv-vllm/
.venv-nori/
.airflow/

# Data and run outputs are rebuilt with `make data` / `make all`
data/
mlruns/
mlflow.db
reports/*.parquet
reports/*.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.DS_Store
